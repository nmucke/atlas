{
  "name": "atlas-research",
  "version": "0.1.0",
  "description": "Local-first research library and project workspace on top of Zotero, with an MCP-connected AI assistant.",
  "license": "MIT",
  "author": "Nikolaj T. Mücke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmucke/atlas.git"
  },
  "homepage": "https://github.com/nmucke/atlas#readme",
  "bugs": {
    "url": "https://github.com/nmucke/atlas/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts --production",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mcp": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/mcp-local.ts",
    "assistant:setup": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/setup-assistant.ts",
    "assistant:register": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/setup-assistant.ts --claude-code"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "katex": "^0.18.9",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "toml-eslint-parser": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "overrides": {
    "katex": "$katex"
  }
}
